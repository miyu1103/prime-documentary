  "master": "H:\\pd-media\\episodes\\PD-2026-065-marmet\\06_voice\\draft\\short268\\en_us\\short268_vc_draft_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "Two nursing-home admission agreements required arbitration for every dispute but one exception: claims to collect late payments owed by the patient.",
      "start": 0.0,
      "end": 7.895,
      "seconds": 7.895,
      "idempotency_key": "sha256:eb53c60b1735a49640eaf49555fb3aace5a41598861938447b445ea4251c7015"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "The paper therefore sent negligence and death claims to a private arbitrator while preserving a courthouse path for collecting an unpaid bill.",
      "start": 8.115,
      "end": 15.963,
      "seconds": 7.848,
      "idempotency_key": "sha256:10576aee16f67cbc38c91853879055c93b14ebef6f83c6b14c0959c44683d3f7"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "A family member had signed each agreement on behalf of a patient who required extensive nursing care.",
      "start": 16.183,
      "end": 21.988,
      "seconds": 5.805,
      "idempotency_key": "sha256:01f68188c91de6646522d38adb35898a0c6e7f0f9d5121c9c19b07fb16ce07ee"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "The Supreme Court's short opinion provides no ages, conditions, admission dates, death dates, or details of the alleged care.",
      "start": 22.208,
      "end": 30.289,
      "seconds": 8.081,
      "idempotency_key": "sha256:fefcf2eedec9981a69c6607a3c1ef4da04cc52d73e1a44a21b143804918ccfce"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "building",
      "text": "The same two contracts also placed the arbitration filing fee on whichever party filed first, without stating a dollar figure.",
      "start": 30.509,
      "end": 38.59,
      "seconds": 8.081,
      "idempotency_key": "sha256:d86f07125ea488eab5ce63c3c3f354f68e17271f0f62aa6aee7602e8464540cf"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "Marchio's agreement was materially different: it required arbitration too, but had no late-payment exception and said nothing about filing fees.",
      "start": 38.81,
      "end": 47.169,
      "seconds": 8.359,
      "idempotency_key": "sha256:81acb6778f727ba6851b98395f8c935d36ae80045fbd0c42dd128e760e1af536"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "building",
      "text": "That difference is why the three families cannot be merged into one story or one supposedly identical form.",
      "start": 47.389,
      "end": 53.473,
      "seconds": 6.084,
      "idempotency_key": "sha256:2bc75aa9076a386eafd88f3195df573a2e3898775dd6b4810cf240f32b22d70d"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "For Brown and Taylor, the asymmetry is simply what the paper says: every dispute goes private, except the home's route to collect late payments.",
      "start": 53.693,
      "end": 61.263,
      "seconds": 7.57,
      "idempotency_key": "sha256:bbca2dc079cbb67607733e12c331d6e967bc7d7fac48b98fc80c10ef2b4c0811"
    }
  ]
}
