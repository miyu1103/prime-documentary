  "master": "H:\\pd-media\\episodes\\PD-2026-062-greene\\06_voice\\draft\\short261\\en_us\\short261_vc_draft_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "The majority said this posted notice failed. The dissent answered with an image: unattended mailboxes, it wrote, are subject to plunder by thieves.",
      "start": 0.0,
      "end": 9.195,
      "seconds": 9.195,
      "idempotency_key": "sha256:ce66f76a8ad89aa9f77bd6d346bb20e253e117d9bb04d46aa1a05fc376140840"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "That argument belonged to the dissent. A mailed letter can be stolen or misdelivered, while posting at least reaches the tenant's door.",
      "start": 9.415,
      "end": 16.753,
      "seconds": 7.338,
      "idempotency_key": "sha256:90ed9b62d96d00656f2c0d8f7d6d00aec0b71477200d8fbbd024867f5870646d"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "The dissent said the majority preferred the Postal Service without proving that mail worked better than a notice fixed to the home.",
      "start": 16.973,
      "end": 23.521,
      "seconds": 6.548,
      "idempotency_key": "sha256:ac0c709d84dfd8d6e733d6fddfe2fa85c82d3b57930b3e692df45e4851b90bb4"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "It also attacked the evidence: scant and conflicting testimony from only a handful of Kentucky process servers.",
      "start": 23.741,
      "end": 30.103,
      "seconds": 6.362,
      "idempotency_key": "sha256:2c4efe5d10ea59d6b38198e73bd07b941aea2e9edf1c49df1283aac8cda3441c"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "building",
      "text": "The dissent counted at least eleven States that allowed notice solely by posting or by leaving it at the residence.",
      "start": 30.323,
      "end": 36.035,
      "seconds": 5.712,
      "idempotency_key": "sha256:a25e5b3579415322744d60a37dd8b7383731ac70a22d5ed6fdbaab539833e9d9"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "The majority's answer was narrower: whatever posting does elsewhere, on this record it did not reliably provide actual notice.",
      "start": 36.255,
      "end": 43.639,
      "seconds": 7.384,
      "idempotency_key": "sha256:106f42b5ad65e9fee92ac91f6b41901234221832322fdd251aaf1bc745b7df0f"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "building",
      "text": "No vote tally is printed in the opinion, so this is not a story about a guessed five-to-four or six-to-three split.",
      "start": 43.859,
      "end": 50.268,
      "seconds": 6.409,
      "idempotency_key": "sha256:50f1eeed72f8d69a68d2cfcd797a017ced62864c931c1533ae56769333ddf063"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "It is a dispute about imperfect delivery systems, ending where the dissent began: with a letter sitting in an unattended mailbox.",
      "start": 50.488,
      "end": 58.104,
      "seconds": 7.616,
      "idempotency_key": "sha256:ca12bd12bcf10b0497b9d4ab44b064226cd079825b040eeafca8ca4678700b80"
    }
  ]
}
