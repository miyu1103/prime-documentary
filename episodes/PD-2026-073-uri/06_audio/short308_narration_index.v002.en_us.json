{
  "short_id": "short308",
  "episode_id": "PD-2026-073-uri",
  "voice_stage": "master",
  "voice_id": "nPczCjzI2devNBz1zQrb",
  "model_id": "eleven_multilingual_v2",
  "estimated_cost_usd": 0.28,
  "total_seconds": 53.88,
  "master": "E:\\pd-media\\episodes\\PD-2026-073-uri\\06_voice\\master\\short308_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "At twenty past one in the morning, north of Austin, an operator gave an order never given at that scale in American history.",
      "start": 0.0,
      "end": 6.269,
      "seconds": 6.269,
      "idempotency_key": "sha256:1ba5d4911afa7836b79702e22fd1bf73144ef988ca8f5b5b8292164e25dc9799"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "Cut the power to twenty thousand megawatts of customers. Now. Before the grid takes itself apart.",
      "start": 6.489,
      "end": 12.062,
      "seconds": 5.573,
      "idempotency_key": "sha256:122e51d806e6546d14aca34c624ecfe64b5ad5b7bc3fb50eba35cd25a78813d1"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "calm",
      "text": "It was the correct order. It is not a failure. It is the thing you do so that the failure does not happen.",
      "start": 12.282,
      "end": 18.459,
      "seconds": 6.177,
      "idempotency_key": "sha256:5d540570aad11049fabbe6fff7808ccce9e709243f81d9242861280feba5d316"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "Twenty thousand megawatts were shed. It was the largest manually controlled load shedding event in United States history. And it was not enough.",
      "start": 18.679,
      "end": 27.178,
      "seconds": 8.499,
      "idempotency_key": "sha256:ce563fe25d15ecbed092d91a92a2cd83cac871271f054bea48516cb0ab7d07a4"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "intense",
      "text": "That morning, the frequency of the Texas grid fell below fifty-nine point four hertz, and stayed there for four minutes and twenty-three seconds. The line was nine minutes.",
      "start": 27.398,
      "end": 36.5,
      "seconds": 9.102,
      "idempotency_key": "sha256:5c64ea3d440d080b9b5563ce131806f4183e967117203f01e1b845a409847e72"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "Not blackouts. A system-wide shutdown, cutting power to millions more and damaging units across the grid.",
      "start": 36.72,
      "end": 43.686,
      "seconds": 6.966,
      "idempotency_key": "sha256:48be6b212b81bcdbe68cb01ac9eeca4114e10f9f6876eb3128a8d4b8458d3652"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "calm",
      "text": "A grid that sheds load comes back when the machines are ready. A grid that trips its machines has to repair them first.",
      "start": 43.906,
      "end": 50.315,
      "seconds": 6.409,
      "idempotency_key": "sha256:eeafb68b73f749fbc1f4baa75d0ce1c081fd35c04215212c4aef297ee222e456"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "Texas got to within four minutes and thirty-seven seconds of that.",
      "start": 50.535,
      "end": 53.879,
      "seconds": 3.344,
      "idempotency_key": "sha256:f746e3b8b5880a9c59c732af3c17d31183d971aba96aef04d2d27df8b2daa3a6"
    }
  ]
}
