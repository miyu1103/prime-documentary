  "master": "E:\\pd-media\\episodes\\PD-2026-071-oroville\\06_voice\\master\\short293_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "The department retained an expert on human population evacuations due to natural disasters.",
      "start": 0.0,
      "end": 5.016,
      "seconds": 5.016,
      "idempotency_key": "sha256:6a46494b5cabcbd1b2111fb7552e828326fdbb4df8848a37cb5816337309558f"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "He stated there is no known method to enumerate who evacuated and who did not, in a given area and time frame, in response to a broadcast evacuation order.",
      "start": 5.236,
      "end": 14.245,
      "seconds": 9.009,
      "idempotency_key": "sha256:e949aeaff34fb07670934375ad449f9d212bf7c681b294b924c5f77094771bb0"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "Read that as engineering rather than law. A broadcast is a signal sent to nobody in particular. It has no delivery receipt.",
      "start": 14.465,
      "end": 21.71,
      "seconds": 7.245,
      "idempotency_key": "sha256:5cf1df75552699d6878982dd369fff8a56de00bac246f648170d9c37ef6c37a5"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "intense",
      "text": "It does not know who heard it, it cannot know who acted on it, and there is no instrument anywhere that can reconstruct that afterwards.",
      "start": 21.93,
      "end": 29.175,
      "seconds": 7.245,
      "idempotency_key": "sha256:5190355629e32dfb35bedce87903b32c7b7c8d865e9c44ca223a2c156391d9de"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "intense",
      "text": "This lack of ascertainability would also prevent individual class members from self-identifying as meeting the class definition.",
      "start": 29.395,
      "end": 36.268,
      "seconds": 6.873,
      "idempotency_key": "sha256:e6f895a0464d4784313e0a42bc7809498bc90a7dd8f231ec3fdf94ef3217c633"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "Ascertainability. Whether the people in a group can be worked out at all.",
      "start": 36.488,
      "end": 40.807,
      "seconds": 4.319,
      "idempotency_key": "sha256:c5e8ca079b2c5156a32717616f7afacb36d3eadf0f2e4eca5653dda7775289b0"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "intense",
      "text": "A woman holding the receipts from her own two days, reading the definition of the class she was trying to represent, could not have told you with certainty whether she was in it.",
      "start": 41.027,
      "end": 50.733,
      "seconds": 9.706,
      "idempotency_key": "sha256:c8df1e443921fa5668059453f75a3cc1074821f4cfa6bc659f346fb6a8603cfd"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "Nobody could. Not the state, not the court, and not the hundred and eighty-eight thousand.",
      "start": 50.953,
      "end": 56.247,
      "seconds": 5.294,
      "idempotency_key": "sha256:df3f016b2668fd5a774402ede2a63dc21716511ab0a4745a22ed245c27a13d5d"
    }
  ]
}
