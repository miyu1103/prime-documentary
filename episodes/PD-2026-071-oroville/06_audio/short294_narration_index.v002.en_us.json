  "master": "E:\\pd-media\\episodes\\PD-2026-071-oroville\\06_voice\\master\\short294_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "Four people put their names on a complaint on behalf of everybody who had been ordered out, asking for the out-of-pocket cost of the two days.",
      "start": 0.0,
      "end": 7.616,
      "seconds": 7.616,
      "idempotency_key": "sha256:9ee36b909abc35feaedbf83e497263f64feea34a27ae15b9edf16a752f8895f8"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "intense",
      "text": "That is the entire claim. Not the dam. Not the crisis. Not damages for fear. Expenses, for two days.",
      "start": 7.836,
      "end": 15.452,
      "seconds": 7.616,
      "idempotency_key": "sha256:11f9f72fab3adb732f5430361dd22797d5f0335d5ecfd3a542237012080fef24"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "A class action is for a harm small enough that no single person could sensibly litigate it, spread across enough people that it adds up to something real.",
      "start": 15.672,
      "end": 24.588,
      "seconds": 8.916,
      "idempotency_key": "sha256:a209ce2c2dd5a8b5e9d15f802f6ca8a8bda067fcd770f2bc42293f31ae60766a"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "But the price of using it is that the group has to be a group. A court has to be able to say, of any person, whether they are in it or out of it.",
      "start": 24.808,
      "end": 32.61,
      "seconds": 7.802,
      "idempotency_key": "sha256:5347972baa9b0fb179b4264fd34866cb6d4fc86e74267b26f1460b7fcec66507"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "intense",
      "text": "Class certification was denied. On the fifteenth of March, twenty twenty-two, the Third District Court of Appeal affirmed.",
      "start": 32.83,
      "end": 39.332,
      "seconds": 6.502,
      "idempotency_key": "sha256:5cecc0ec6391cf68d822a8d9c7d1d1715caf9d665959449d79ca1e584440b1ff"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "The disposition of an appeal is usually two sentences of housekeeping. Here they are.",
      "start": 39.552,
      "end": 44.01,
      "seconds": 4.458,
      "idempotency_key": "sha256:171004e6fd6becae2c6c575b2ddc7736517767442cdc3b46419146bc16c2d649"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "intense",
      "text": "The judgment is affirmed. Respondent Department of Water Resources shall recover its costs on appeal.",
      "start": 44.23,
      "end": 49.942,
      "seconds": 5.712,
      "idempotency_key": "sha256:9e5e722bb2d486e41232fc80eab16053a45fdab56bcdda8b4b2c2d7acd4fb4b2"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "The four people who had asked the State to reimburse two days of expenses were ordered to pay the State's costs of the appeal.",
      "start": 50.162,
      "end": 56.71,
      "seconds": 6.548,
      "idempotency_key": "sha256:d97bb0981b39aa6489ad15d603e2ff4410c87434e599c479607ccd1f4adcd1c6"
    }
  ]
}
