  "master": "E:\\pd-media\\episodes\\PD-2026-074-itaewon\\06_voice\\master\\short295_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "Thirty-four minutes past six, on a Saturday evening in Seoul, someone walked out of a crowded alley and called the police.",
      "start": 0.0,
      "end": 6.13,
      "seconds": 6.13,
      "idempotency_key": "sha256:f0b5a1eacf93bca2d7c497d4e96c2c2feedac0ae6853cf1fe4a1316028d57069"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "It was not a crime they were reporting. They said people were being forced uphill into a place where there was no room to come back down.",
      "start": 6.35,
      "end": 13.362,
      "seconds": 7.012,
      "idempotency_key": "sha256:580aa89d622d533fde40b03dbab430d7ddeb2ba8507fccef959cdb98e064c97d"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "Four hours before anything happened, a person standing in that alley used the words crushed to death, and asked for somebody to come and control it.",
      "start": 13.582,
      "end": 20.78,
      "seconds": 7.198,
      "idempotency_key": "sha256:bdb5d0849fe1771b46c0a7f5f4cbd74248c32bf3eeb87bfa3e7a9e2b38b6824f"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "intense",
      "text": "Between six thirty-four in the evening and eleven minutes past ten, the police in Itaewon received eleven distress reports about dangerous levels of overcrowding.",
      "start": 21.0,
      "end": 29.591,
      "seconds": 8.591,
      "idempotency_key": "sha256:b83a7edbc2e5f054261e22f592bccb7243eb6952d87418bb3920d63f1135d6f8"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "calm",
      "text": "Officers were sent. They dispersed crowds where they went.",
      "start": 29.811,
      "end": 33.062,
      "seconds": 3.251,
      "idempotency_key": "sha256:dd18ac85c45097beefbca7a35b56e1c7601e45825e9e6bee9b3732267c1f6988"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "The calls kept coming, and the language in them stopped being about congestion. I am almost being crushed to death.",
      "start": 33.282,
      "end": 39.551,
      "seconds": 6.269,
      "idempotency_key": "sha256:4319c09548b7e8dab8834494b6b116801498b44d2e19526a5c72d41a7395e14f"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "intense",
      "text": "Eleven calls. Officers were deployed to four of them. On the other seven, according to Al Jazeera's reporting at the time, there was no action.",
      "start": 39.771,
      "end": 47.944,
      "seconds": 8.173,
      "idempotency_key": "sha256:0f9fffff9a08af165ebbc13b4d10dbd3ac4d9e8165fa606b72bc0c4590a5a176"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "The question is not who to blame. It is what happens to a warning after somebody makes it.",
      "start": 48.164,
      "end": 53.412,
      "seconds": 5.248,
      "idempotency_key": "sha256:1394f21f7058656906ca620bfcff4435d9b53ab67baa19dd261a0f92b94dbb05"
    }
  ]
}
