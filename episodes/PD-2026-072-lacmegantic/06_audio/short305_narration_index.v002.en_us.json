  "master": "E:\\pd-media\\episodes\\PD-2026-072-lacmegantic\\06_voice\\master\\short305_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "Before the investigation reached any question of who did what, it looked at the tank cars, and what it found there is its own kind of answer.",
      "start": 0.0,
      "end": 8.313,
      "seconds": 8.313,
      "idempotency_key": "sha256:d4a2b9ac2edaadd1492905c32f5e7305e5dfe5f13c05f8edd35b2fd6f8a0d1b0"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "All sixty-three of the derailed cars had been built to a single specification. Seventy-eight per cent of them were less than five years old.",
      "start": 8.533,
      "end": 16.149,
      "seconds": 7.616,
      "idempotency_key": "sha256:34494a431ca8f4ad2dfec66ff7625efcf87f1e2c7939a9a03d3b1b1deb444438"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "Fifty-nine of the sixty-three were breached. Ninety-four per cent. Thirty-seven of them were holed through the shell.",
      "start": 16.369,
      "end": 22.638,
      "seconds": 6.269,
      "idempotency_key": "sha256:57027a94209c4fae6ecb4487e97e1f15a1a4fea0c433e8a04545d8becbbf5d33"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "calm",
      "text": "All sixty-three derailed tank cars were in compliance with the specification requirement that was in effect at the time of their approval and construction.",
      "start": 22.858,
      "end": 30.892,
      "seconds": 8.034,
      "idempotency_key": "sha256:cb1431ae93ef2e0a24185567d81d47ae7fd7c63424c98a855d1e7c298d8116b1"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "intense",
      "text": "They were legal. They were current. Ninety-four per cent of them opened.",
      "start": 31.112,
      "end": 34.874,
      "seconds": 3.762,
      "idempotency_key": "sha256:e0042ad6ac27baef564fea5b9e1d1d65d047d855f744df931b797339038e6692"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "calm",
      "text": "Compliance is not a description of how strong something is. It is a description of what was asked of it, on the day it was approved.",
      "start": 35.094,
      "end": 42.524,
      "seconds": 7.43,
      "idempotency_key": "sha256:d5b5deae70109b0d68ca12e2b02553535399f8d0feade44087df4fd5a5ef5140"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "building",
      "text": "A car built in nineteen eighty and a car built in twenty twelve were both in compliance, because the requirement had not moved between them.",
      "start": 42.744,
      "end": 49.942,
      "seconds": 7.198,
      "idempotency_key": "sha256:48db8a4eaa3377adb12e2680d1c9cf1f07b844db0aab731df1b149767aaf44c4"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "The damage clearly indicated that product release could have been reduced had the tank car shells and heads been more impact-resistant.",
      "start": 50.162,
      "end": 56.756,
      "seconds": 6.594,
      "idempotency_key": "sha256:c4e4e32654b4eb3b8df5970140417f349f926306cd9a9a71d51945932994572a"
    }
  ]
}
