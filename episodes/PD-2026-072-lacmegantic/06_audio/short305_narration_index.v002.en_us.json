{
  "short_id": "short305",
  "episode_id": "PD-2026-072-lacmegantic",
  "voice_stage": "master",
  "voice_id": "nPczCjzI2devNBz1zQrb",
  "model_id": "eleven_multilingual_v2",
  "estimated_cost_usd": 0.31,
