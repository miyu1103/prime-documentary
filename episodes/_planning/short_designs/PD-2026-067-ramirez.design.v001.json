    {
      "short_id": "short276",
      "angle": "Five to four: a company can break a law Congress wrote for you, and that alone does not get you into a federal courtroom.",
      "avoids": "No claim the Court found the reports accurate; no damages figure; no assertion about what the ruling does to any other statute; no vote attributed to a justice who did not cast it.",
      "funnel_question_left_for_longform": "The company could not confirm that a single alert it sold was accurate. Why was that not the question?",
      "loop": true,
      "loop_join": "The last line returns to the sentence the first line opened with.",
      "era": "Supreme Court of the United States, 25 June 2021",
      "lines": [
        {
          "id": "L1",
          "text": "No concrete harm, no standing.",
          "delivery": "intense",
          "source_lines": [
            "No concrete harm, no standing."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L2",
          "text": "That is the first thing the Supreme Court said about this case, on the twenty-fifth of June, 2021.",
          "delivery": "building",
          "source_lines": [
            "That is the first thing the Supreme Court of the United States said about this case, on the twenty-fifth of June, 2021."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L3",
          "text": "Five to four.",
          "delivery": "intense",
          "source_lines": [
            "Five to four."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L4",
          "text": "The holding is one sentence long.",
          "delivery": "building",
          "source_lines": [
            "The holding is one sentence long."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L5",
          "text": "Only plaintiffs concretely harmed by a statutory violation have standing to seek damages in federal court.",
          "delivery": "building",
          "source_lines": [
            "Only plaintiffs concretely harmed by a defendant's statutory violation have Article III standing to seek damages against that private defendant in federal court."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L6",
          "text": "Congress can write a law that says a company owes you something. The company can break it.",
          "delivery": "building",
          "source_lines": [
            "Congress can write a law that says a company owes you something. The company can break it."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L7",
          "text": "That, on its own, does not get you into a federal courtroom.",
          "delivery": "intense",
          "source_lines": [
            "That, on its own, does not get you into a federal courtroom."
          ],
          "claims": [
            "R-TRANSUNION"
          ]
        },
        {
          "id": "L8",
          "text": "In dissent: the Constitution prohibits consumers from vindicating their rights. The Constitution does no such thing.",
          "delivery": "intense",
          "source_lines": [
            "the majority decides that TransUnion's actions are so insignificant that the Constitution prohibits consumers from vindicating their rights in federal court. The Constitution does no such thing."
          ],
          "claims": [
            "R-THOMAS"
          ]
        }
      ],
