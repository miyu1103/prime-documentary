      "short_id": "short274",
      "angle": "A man went to buy a car with his wife and his father-in-law. The credit check said his name was on a terrorist list.",
      "avoids": "No claim the list itself was wrong about anyone else; no count of the list presented as a Treasury figure; no damages number in this Short; no claim he was arrested or charged.",
      "funnel_question_left_for_longform": "The letter that followed did not say how to argue with it. Who does a person appeal to?",
      "loop": true,
      "loop_join": "The last line returns to the counter the first line opened on.",
      "era": "Dublin, California, 27 February 2011",
      "lines": [
        {
          "id": "L1",
          "text": "Dublin, California. February 27th, 2011.",
          "delivery": "building",
          "source_lines": [
            "Dublin, California. February 27th, 2011."
          ],
          "claims": [
            "R-HOOK"
          ]
        },
        {
          "id": "L2",
          "text": "Sergio Ramirez has come to buy a Nissan Maxima.",
          "delivery": "building",
          "source_lines": [
            "Sergio Ramirez has come to buy a Nissan Maxima."
          ],
          "claims": [
            "R-HOOK"
          ]
        },
        {
          "id": "L3",
          "text": "His wife is with him, and his father-in-law.",
          "delivery": "building",
          "source_lines": [
            "His wife is with him, and his father-in-law."
          ],
          "claims": [
            "R-HOOK"
          ]
        },
        {
          "id": "L4",
          "text": "The salesman runs a credit check, and says Nissan will not sell him the car.",
          "delivery": "building",
          "source_lines": [
            "The salesman runs a credit check, and says Nissan will not sell him the car."
          ],
          "claims": [
            "R-HOOK"
          ]
        },
        {
          "id": "L5",
          "text": "His name is on a terrorist list.",
          "delivery": "intense",
          "source_lines": [
            "His name is on a terrorist list."
          ],
          "claims": [
            "R-HOOK"
          ]
        },
        {
          "id": "L6",
          "text": "The list is real, and it belongs to the Treasury.",
          "delivery": "building",
          "source_lines": [
            "The list is real, and it belongs to the Treasury."
          ],
          "claims": [
            "R-OFAC"
          ]
        },
        {
          "id": "L7",
          "text": "It is generally unlawful to transact business with any person on the list.",
          "delivery": "building",
          "source_lines": [
            "Individuals on the OFAC list are terrorists, drug traffickers, or other serious criminals. It is generally unlawful to transact business with any person on the list."
          ],
          "claims": [
            "R-OFAC"
          ]
        },
        {
          "id": "L8",
          "text": "The letter that follows will not say how to argue with it.",
          "delivery": "intense",
          "source_lines": [
            "The letter that follows will not say how to argue with it."
          ],
          "claims": [
            "R-HOOK"
          ]
        }
