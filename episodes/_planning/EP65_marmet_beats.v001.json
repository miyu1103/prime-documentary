        "SUMMARILY"
      ]
    },
    {
      "kind": "quote",
      "quote": "Substantive unconscionability may manifest itself in the form of an agreement requiring arbitration only for the claims of the weaker party but a choice of forums for the claims of the stronger party.",
      "attribution": "Brown II (2012)"
    },
    {
      "kind": "quote",
      "quote": "Agreements to arbitrate must contain at least a modicum of bilaterality to avoid unconscionability.",
      "attribution": "Brown II (2012)"
