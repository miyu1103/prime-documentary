  "master": "E:\\pd-media\\episodes\\PD-2026-075-lahaina\\06_voice\\master\\short299_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "At sixteen minutes past four in the afternoon, the first evacuation order in that log that names a Lahaina neighbourhood was sent.",
      "start": 0.0,
      "end": 6.873,
      "seconds": 6.873,
      "idempotency_key": "sha256:490e329a267080d77d8c3e2fcfd91693f2b64ea5b41bf41ce4d6d9df92bec17d"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "Evacuate your family and pets now, do not delay. Shelter is open at Lahaina Civic Center.",
      "start": 7.093,
      "end": 12.619,
      "seconds": 5.526,
      "idempotency_key": "sha256:46ab15121632b6030b666985de6b937babeb6bc5bcb453658182a40a43a3edc9"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "intense",
      "text": "The shelter named in that message had closed two hours and sixteen minutes earlier.",
      "start": 12.839,
      "end": 16.879,
      "seconds": 4.04,
      "idempotency_key": "sha256:683e9bcd0fb6d69601bb94c890c97440a0e8c30bfb97d01a178aae7dc1cbaa49"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "And the message was sent to cellphones, in a region where cellular phone communication had been destroyed in the late morning.",
      "start": 17.099,
      "end": 23.461,
      "seconds": 6.362,
      "idempotency_key": "sha256:b780db3b80f47241010a506fa582414430bfba66becc543fe6598d5b2abde1dc"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "calm",
      "text": "With no cellular communication, residents were not able to receive emergency alerts. That is the state's own sentence.",
      "start": 23.681,
      "end": 30.136,
      "seconds": 6.455,
      "idempotency_key": "sha256:385c1b0408e5163f42c63c69d5626a9ed890231abc5d01d855c815de9aa7f20f"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "calm",
      "text": "The County says it sent at least fourteen alert messages, and that all twenty-one cell towers serving West Maui failed.",
      "start": 30.356,
      "end": 36.997,
      "seconds": 6.641,
      "idempotency_key": "sha256:03faeb1d45a4d92be843468255f1295b44ca1c944617184ea9bf2e25e7a57919"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "building",
      "text": "Finding thirty-six. Many residents did not receive a text notification from the county regarding the high winds and high fire danger.",
      "start": 37.217,
      "end": 45.437,
      "seconds": 8.22,
      "idempotency_key": "sha256:1f4bf8f011386cb8384285ddb9ecfada6d0548387aa70fc0229769ab2db7b977"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "An evacuation order at sixteen minutes past four, naming a shelter that had closed at two, sent to a network that had already died.",
      "start": 45.657,
      "end": 53.552,
      "seconds": 7.895,
      "idempotency_key": "sha256:8c9c3e57604acd83fcac80583ea182234c5a1a7221e994f5725e9236741840fb"
    }
  ]
}
