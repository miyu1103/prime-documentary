  "master": "E:\\pd-media\\episodes\\PD-2026-070-wronghouse\\06_voice\\master\\short290_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "At about half past three that morning, two agents drove out to look at the target one last time.",
      "start": 0.0,
      "end": 5.433,
      "seconds": 5.433,
      "idempotency_key": "sha256:7ca60c6983f9e979e56bcfab126c00b066a588c90de6d51c03372d483a829acc"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "He dimmed his headlights so nobody would notice the car. And he navigated using a personal GPS device. His own. Not the Bureau's.",
      "start": 5.653,
      "end": 13.083,
      "seconds": 7.43,
      "idempotency_key": "sha256:ebefbb537ea345345c06febfe9d5814cff3fed210b45869e4d99350c83dd39c8"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "intense",
      "text": "It took him to 3756 Denville Trace. He was looking at the wrong house, and everything he saw confirmed he was at the right one.",
      "start": 13.303,
      "end": 20.826,
      "seconds": 7.523,
      "idempotency_key": "sha256:af509e1742fdfbb71df0220658da9e401038ae795ea972dbcb407f843dee0516"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "A tan split-level. A corner lot. A large tree. A stoop. He even saw a street sign that said Landau Lane.",
      "start": 21.046,
      "end": 28.476,
      "seconds": 7.43,
      "idempotency_key": "sha256:cef9231670c03615d74d2b6ca6b9087f5d1db12c7d5d9ab598cc7900a782bc1d"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "building",
      "text": "There was one thing in the driveway that had not been there on his first visit. A black Camaro. He noted it as a landmark.",
      "start": 28.696,
      "end": 35.523,
      "seconds": 6.827,
      "idempotency_key": "sha256:72b5a0dec4d3f0b3bea739deb4988c94eb7a6966a689f3afaff23587dbe610e2"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "intense",
      "text": "The man named in the warrant was not known to drive a black Camaro. The car he navigated by belonged to the family he was about to raid.",
      "start": 35.743,
      "end": 42.291,
      "seconds": 6.548,
      "idempotency_key": "sha256:08e087795ddbc2201b3fdc0e39b2b63770848f4d145a1f81d3f03582a1ffcda6"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "intense",
      "text": "No one could confirm as much later, because Agent Guerra threw away his GPS device not long after the raid.",
      "start": 42.511,
      "end": 48.362,
      "seconds": 5.851,
      "idempotency_key": "sha256:69f5693b0b985eda3f3f710548cd66e3f9b83df0e131df7acbad677bebd5db2d"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "This film is not going to tell you why he threw it away, because no court has decided that.",
      "start": 48.582,
      "end": 53.272,
      "seconds": 4.69,
      "idempotency_key": "sha256:281c683d3feb02470085cbc27ca78c7f71f02534b3755432da1befadccfe1f07"
    }
  ]
}
