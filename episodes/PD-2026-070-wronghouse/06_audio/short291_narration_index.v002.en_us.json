  "master": "E:\\pd-media\\episodes\\PD-2026-070-wronghouse\\06_voice\\master\\short291_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "The district court file in this case now runs to two hundred and twenty-three entries.",
      "start": 0.0,
      "end": 4.272,
      "seconds": 4.272,
      "idempotency_key": "sha256:ccacd8d6c1bb82d35a8ae31fe8cf11688a3a8185ac93056066988b343722b15d"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "Motions, orders, depositions, a mediation, two reconsiderations, a judgment, an appeal, a Supreme Court, and a box of sealed envelopes that went to Washington and came back.",
      "start": 4.492,
      "end": 16.148,
      "seconds": 11.656,
      "idempotency_key": "sha256:cdc77244b0563f185cabbf29bacaebfa451de6f6f2c449be6b086255ddc92eb4"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "building",
      "text": "Not one of those entries is a trial.",
      "start": 16.368,
      "end": 18.411,
      "seconds": 2.043,
      "idempotency_key": "sha256:abe639ce99c2b0009c6d45259c1b56aeb01d3c554c984cfc682c08fcddea3edb"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "intense",
      "text": "Seven years and eight months after the door came in, this family won at the Supreme Court of the United States, unanimously.",
      "start": 18.631,
      "end": 24.715,
      "seconds": 6.084,
      "idempotency_key": "sha256:2536c1b4f28a4a7d05741583080d9becc60d8f3cc62b77b45615997d24c8955d"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "intense",
      "text": "Winning that did not give them a trial. It did not give them a dollar. It did not decide whether they can sue at all.",
      "start": 24.935,
      "end": 30.647,
      "seconds": 5.712,
      "idempotency_key": "sha256:328aa442946f32ffc447c3e8fd71e3f87a683d88b622ab10f7d9e41362d6c500"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "building",
      "text": "It has been eight years, nine months and twenty-five days since six federal agents walked up the wrong driveway in the dark.",
      "start": 30.867,
      "end": 36.951,
      "seconds": 6.084,
      "idempotency_key": "sha256:4246331069b5bf11e5da55645d011c13c2b200ece4ce892cf1b29966cbc1be88"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "intense",
      "text": "Nobody has been found liable. Nobody has been disciplined on any record this film could find. No damages have been awarded. No jury has heard a word of it.",
      "start": 37.171,
      "end": 46.413,
      "seconds": 9.242,
      "idempotency_key": "sha256:3854dacf12c3689f4a16f6fb50754bb473ca2c45da4cc7e45aeb78e84aabdcd6"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "And the only thing anyone can say with certainty about what happens next is that nobody knows.",
      "start": 46.633,
      "end": 51.231,
      "seconds": 4.598,
      "idempotency_key": "sha256:eb05fd03691401cdcb93b3a17544772548641644ee2bb1c68ac094c0327007d5"
    }
  ]
}
