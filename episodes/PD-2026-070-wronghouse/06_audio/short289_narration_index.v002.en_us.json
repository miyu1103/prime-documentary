  "master": "E:\\pd-media\\episodes\\PD-2026-070-wronghouse\\06_voice\\master\\short289_vc_master_en_us_v002.mp3",
  "lines": [
    {
      "id": "L1",
      "chunk_id": "L1",
      "delivery": "intense",
      "text": "When the case reached a judge, the FBI's own representative was asked what the rules were. Not what the agent did. What the Bureau requires.",
      "start": 0.0,
      "end": 7.523,
      "seconds": 7.523,
      "idempotency_key": "sha256:302bccda3917d53a2190f19e052531a901329f71f6b6c3b22a8c325bbcb8baa9"
    },
    {
      "id": "L2",
      "chunk_id": "L2",
      "delivery": "building",
      "text": "No FBI policy or procedure dictates how to locate or navigate to the target, whether to use a GPS device, or what type of GPS device must be used.",
      "start": 7.743,
      "end": 16.938,
      "seconds": 9.195,
      "idempotency_key": "sha256:4fb5643b5ea46dc8daae99c95ebc395ee6db794bbbc16e14b5efc2f59df1d2a1"
    },
    {
      "id": "L3",
      "chunk_id": "L3",
      "delivery": "intense",
      "text": "Whether or how to conduct a site survey or drive-by of a target location. Or how long to wait before entering after knocking and announcing.",
      "start": 17.158,
      "end": 25.61,
      "seconds": 8.452,
      "idempotency_key": "sha256:96b15c9430b9d0a88af8bc73ccfe9193927ab73d7bfcc3554331141d0c00b8d4"
    },
    {
      "id": "L4",
      "chunk_id": "L4",
      "delivery": "building",
      "text": "There is no rule that says check the house number. There is no rule that says use Bureau equipment.",
      "start": 25.83,
      "end": 31.31,
      "seconds": 5.48,
      "idempotency_key": "sha256:b112ff5b429c57773561d2d9a90ac5c4f64b25c03435c73e277504e227d466da"
    },
    {
      "id": "L5",
      "chunk_id": "L5",
      "delivery": "building",
      "text": "There is no rule about whether you look at the place at all before you break into it. There is no rule about how long you wait after you knock.",
      "start": 31.53,
      "end": 38.496,
      "seconds": 6.966,
      "idempotency_key": "sha256:123589307e13e9c278ab408e3cfe779ea876adc4d1db684d335fa25ff7abff00"
    },
    {
      "id": "L6",
      "chunk_id": "L6",
      "delivery": "intense",
      "text": "Which means that on the morning of the eighteenth of October, twenty-seventeen, nobody in that team broke a rule.",
      "start": 38.716,
      "end": 44.475,
      "seconds": 5.759,
      "idempotency_key": "sha256:35f30cc38ba788de85c97228b0d6c9d7fb96c9176601fdb1158a5e4461974424"
    },
    {
      "id": "L7",
      "chunk_id": "L7",
      "delivery": "intense",
      "text": "Because there was no rule to break.",
      "start": 44.695,
      "end": 46.785,
      "seconds": 2.09,
      "idempotency_key": "sha256:907a1d67146ebb66acdc7cf7362ee2fbfe082a32b00e75f1d2f88a7e796b24e9"
    },
    {
      "id": "L8",
      "chunk_id": "L8",
      "delivery": "calm",
      "text": "And that sentence -- there was no rule to break -- is not the end of this family's problem. It is the beginning of it.",
      "start": 47.005,
      "end": 53.739,
      "seconds": 6.734,
      "idempotency_key": "sha256:a396e02ef3ee2e4f26942a996eefc995a54ff062ebee573cbce7976ecf6747c5"
    }
  ]
}
