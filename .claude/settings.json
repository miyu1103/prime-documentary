{
  "model": "opus",
  "fastMode": true,
  "language": "japanese",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read", "Glob", "Grep",
      "Bash(*)",
      "PowerShell(*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git switch:*)",
      "Bash(git branch:*)", "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git push:*)", "Bash(git stash:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(pwd)", "Bash(mkdir:*)",
      "Bash(pytest:*)", "Bash(python -m pytest:*)",
      "Bash(make test)", "Bash(make validate)", "Bash(make demo)",
      "Bash(python scripts/validate_all_v2.py:*)", "Bash(python scripts/validate_examples.py:*)",
      "Bash(Get-Volume:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)", "Bash(git push:* --force:*)", "Bash(git reset --hard:*)",
      "Bash(git reset --hard *)", "Bash(git clean -f*)", "Bash(git push --force*)", "Bash(git push -f*)",
      "Edit(/.git/**)",
      "Edit(//h/pd-media/assets/**)",
      "Edit(//h/pd-media/renders/baseline/**)",
      "Read(//**/.env)",
      "Read(//**/.ssh/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git commit *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv add *)",
      "Bash(npm install *)",
      "Bash(pnpm install *)",
      "Bash(yarn add *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(huggingface-cli *)",
      "Bash(hf download *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(pnpm i *)",
      "Bash(yarn install *)",
      "Bash(git clone *)",
      "Bash(gh repo clone *)",
      "Bash(git lfs pull *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(Invoke-RestMethod *)",
      "Bash(Start-BitsTransfer *)",
      "Bash(winget install *)",
      "Bash(choco install *)",
      "Bash(scoop install *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "py -3.11 \"${CLAUDE_PROJECT_DIR}/scripts/pd_brief.py\"", "timeout": 20 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell", "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PROJECT_DIR}/scripts/guard_destructive.py\"", "timeout": 20 } ] },
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pd_safety_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "python scripts/check_secrets.py", "timeout": 20 } ] },
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "py -3.11 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pd_decision_reminder.py\"", "timeout": 10 } ] }
    ]
  }
}
